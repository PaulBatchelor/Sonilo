cflags = -g -Wall -pedantic -std=c89 -I.
libs = -L. -lsonilo

rule c89
    command = gcc -std=c89 -c $cflags $in -o $out
    description = c89 $in

rule ar
    command = ar rcs $out $in
    description = creating $out

rule link
    command = gcc $cflags $in -o $out $ldflags $libs
    description = creating $out


build sonilo.o: c89 sonilo.c
build t.o: c89 t.c
build mem.o: c89 mem.c
build ins.o: c89 ins.c
build ugen.o: c89 ugen.c
build port.o: c89 port.c
build context.o: c89 context.c
build array.o: c89 array.c
build iter.o: c89 iter.c
build dsp/load.o: c89 dsp/load.c
build dsp/sink.o: c89 dsp/sink.c
build dsp/sine.o: c89 dsp/sine.c
build dsp/arith.o: c89 dsp/arith.c
build dsp/blsaw.o: c89 dsp/blsaw.c
build dsp/butterworth.o: c89 dsp/butterworth.c
build libsonilo.a: ar $
    mem.o $
    ins.o $
    ugen.o $
    port.o $
    context.o $
    array.o $
    iter.o $
    dsp/load.o $
    dsp/sink.o $
    dsp/sine.o $
    dsp/arith.o $
    dsp/blsaw.o $
    dsp/butterworth.o $
    sonilo.o

build ex/hello_ugen.o: c89 ex/hello_ugen.c
build ex/sines.o: c89 ex/sines.c
build ex/seq.o: c89 ex/seq.c

build t: link t.o | libsonilo.a
build ex/hello_ugen: link ex/hello_ugen.o | libsonilo.a
build ex/sines: link ex/sines.o | libsonilo.a
build ex/seq: link ex/seq.o | libsonilo.a

default t ex/hello_ugen ex/sines ex/seq
