cflags = -g -Wall -pedantic -I. -Icmp -Idr_wav
libs = -L. -lsonilo -lm

rule c89
    command = gcc -std=c89 -c $cflags $in -o $out
    description = c89 $in

rule ar
    command = ar rcs $out $in
    description = creating $out

rule link
    command = gcc $cflags $in -o $out $ldflags $libs
    description = creating $out

rule unu
    command = ./konilo/unu $in > $out

rule pali
    command = ./konilo/pali $in $out

rule sh
    command = sh $in

build sonilo.o: c89 sonilo.c
build t.o: c89 t.c
build mem.o: c89 mem.c
build ins.o: c89 ins.c
build ugen.o: c89 ugen.c
build port.o: c89 port.c
build context.o: c89 context.c
build array.o: c89 array.c
build iter.o: c89 iter.c
build universe.o: c89 universe.c
build wm.o: c89 wm.c
build op.o: c89 op.c
build dsp/load.o: c89 dsp/load.c
build dsp/sink.o: c89 dsp/sink.c
build dsp/sine.o: c89 dsp/sine.c
build dsp/arith.o: c89 dsp/arith.c
build dsp/blsaw.o: c89 dsp/blsaw.c
build dsp/butterworth.o: c89 dsp/butterworth.c
build dsp/clock.o: c89 dsp/clock.c
build dsp/metro.o: c89 dsp/metro.c
build dsp/seq.o: c89 dsp/seq.c
build dsp/mtof.o: c89 dsp/mtof.c
build dsp/smoother.o: c89 dsp/smoother.c
build dsp/bigverb.o: c89 dsp/bigverb.c
build dsp/env.o: c89 dsp/env.c
build dsp/rephasor.o: c89 dsp/rephasor.c
build dsp/curve.o: c89 dsp/curve.c
build dsp/terp.o: c89 dsp/terp.c
build dsp/bez.o: c89 dsp/bez.c
build dsp/phasor.o: c89 dsp/phasor.c
build dsp/warp.o: c89 dsp/warp.c
build dsp/scale.o: c89 dsp/scale.c
build cmp/cmp.o: c89 cmp/cmp.c
build konilo/ilo.o: c89 konilo/ilo.c
build konilo/unu.o: c89 konilo/unu.c
build konilo/pali.o: c89 konilo/pali.c
build tape.o: c89 tape.c
build ji.o: c89 ji.c
build libsonilo.a: ar $
    mem.o $
    ins.o $
    ugen.o $
    port.o $
    context.o $
    array.o $
    iter.o $
    universe.o $
    wm.o $
    op.o $
    tape.o $
    ji.o $
    cmp/cmp.o $
    dsp/load.o $
    dsp/sink.o $
    dsp/sine.o $
    dsp/arith.o $
    dsp/blsaw.o $
    dsp/butterworth.o $
    dsp/clock.o $
    dsp/metro.o $
    dsp/seq.o $
    dsp/mtof.o $
    dsp/smoother.o $
    dsp/bigverb.o $
    dsp/env.o $
    dsp/rephasor.o $
    dsp/curve.o $
    dsp/terp.o $
    dsp/bez.o $
    dsp/phasor.o $
    dsp/warp.o $
    dsp/scale.o $
    sonilo.o

build ex/hello_ugen.o: c89 ex/hello_ugen.c
build ex/sines.o: c89 ex/sines.c
build ex/seq.o: c89 ex/seq.c
build ex/opseq.o: c89 ex/opseq.c

build t: link t.o | libsonilo.a
build ex/hello_ugen: link ex/hello_ugen.o | libsonilo.a
build ex/sines: link ex/sines.o | libsonilo.a
build ex/seq: link ex/seq.o | libsonilo.a
build ex/opseq: link ex/opseq.o | libsonilo.a
build sonilo: link konilo/ilo.o | libsonilo.a
build ex/seq.fth: unu ex/seq.unu | konilo/unu
build ilo.rom: pali konilo/konilo.pali | konilo/pali
build ilo.blocks: sh mkblocks.sh | sonilo bootstrap.fth

build konilo/unu: link konilo/unu.o
    libs=
build konilo/pali: link konilo/pali.o
    libs=

default t ex/hello_ugen ex/sines ex/seq ex/opseq sonilo
default ex/seq.fth
default ilo.rom ilo.blocks
