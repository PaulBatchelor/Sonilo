Lots of word definitions
~~~
:son:ins #2164260864 ;
:son:send #8 io ;
:son:rw-get #9 io ;
:son:rw-set #10 io ;
:son:key #8 shift-left #10551296 n:add ;
:son:magic son:ins son:send ;
:son:sys swap #16 shift-left #204 #8 shift-left n:add n:add
son:ins n:add ; 
:son:rw-print #00 #03 son:sys son:send ;
:son:begin #00 #01 son:sys son:send ;
:son:end #00 #02 son:sys son:send ;
:son:msb #16 shift-right #2164326400 n:add ;
:son:lsb #65535 and #2164391936 n:add ;
:son:word dup son:msb son:send son:lsb son:send ;
:son:opa son:key son:ins n:add n:add son:send ;
:son:opb #206 swap son:opa son:word ;
:pw son:begin #00 #33 son:opa son:end ;
:setw son:begin #33 son:opb son:end ;
:ugen son:begin #117 son:opb son:end ;
:metro #24870 ugen ;
:constf
dup #0 lteq? n:abs #29 shift-left
swap n:abs dup #1000 n:mod #8192 n:mul #1000 n:div
swap #1000 n:div #13 shift-left or or
son:begin #99 son:opb son:end
;
:const #1000 n:mul constf ;
:clock #4820 ugen ;
:mtof #25802 ugen ;
:saw #36908 ugen ;
:lpf #23498 ugen ;
:mul #25878 ugen ;
:seq #37152 ugen ;
:sink #37716 ugen ;
:last-ugen son:begin #0 #117 son:opa son:end ;
:tape #116 son:opa ;
:bind #16 shift-left or son:rw-set son:begin #2 tape son:end ;
:topen son:begin #0 tape son:end ;
:tclose son:begin #1 tape son:end ;
:render son:begin #114 son:opb son:end ;
:son:ctx-create son:begin #0 #67 son:opa son:end ;
:son:cur son:begin #1 n:add #107 son:opa son:end ;
:son:go son:begin #0 #107 son:opa son:end ;
:son:ctx-destroy son:begin #1 #67 son:opa son:end ;
:son:push son:begin $w son:opb son:end ;
:son:pop son:begin #0 $w son:opa son:end ;
:son:array-create son:push son:begin #0 $a son:opa son:end ;
:son:array-write (avn-)
(anv)
swap son:push son:push son:push
son:begin #1 $a son:opa son:end
;
:son:iter son:push son:begin #0 $i son:opa son:end ;
:smoother #37660 ugen ;
~~~
Set up the array for storing the pitch sequence.
~~~
'vals var @Free !vals #9 allot #8 @vals store

#0 #5 #7 #10 #12 #10 #7 #5
#8 [
@vals
#7 I n:sub
a:store
] indexed-times

~~~
Set up a context for creating a patch. Make sure that
the address of this context is set to cursor 0.
~~~
son:ctx-create #0 son:cur son:go
~~~
Convert a clock signal into a
trigger signal via metro.
~~~
#125 #4 n:mul const clock metro
~~~
Create an array of 8 8-bit (2^3) values, packed in a
single word: len.wrdsz.
~~~
#3 #8 #4 shift-left or son:array-create
~~~
Retrieve the array address (pop, rwget), and populate
with sequence values in the array stack.
~~~
son:pop son:rw-get
#8 [ dup @vals I a:fetch #60 n:add I son:array-write ] indexed-times
~~~
Create an array iterator, followed by the sequencer
~~~
son:iter seq #0.001 constf smoother
~~~
The rest of the patch
~~~
mtof saw #200 const lpf #0.500 constf mul sink
#0 setw topen
#0 last-ugen son:rw-get bind
#11 render
#0 setw tclose
son:ctx-destroy
bye
~~~
